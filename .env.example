DATABASE_URL=postgresql://nfrp_demo:change-me-db@postgres:5432/nfrp_demo?schema=public
POSTGRES_USER=nfrp_demo
POSTGRES_PASSWORD=change-me-db
POSTGRES_DB=nfrp_demo

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-local-demo
AUTH_SECRET=replace-with-at-least-32-random-characters

DEPLOYMENT_MODE=local
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000
APP_PUBLIC_URL=http://localhost:3000
# Empty = inferred from APP_PUBLIC_URL. Set only when a reverse proxy requires an override.
COOKIE_SECURE=
# Token opzionale per POST /api/ingestion da n8n/email/Nextcloud. Generare con: openssl rand -hex 32
INGESTION_API_TOKEN=

ASSISTANT_ENABLED=false
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:1.7b

UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=20
INBOX_OCR_ENABLED=true
INBOX_OCR_LANGUAGES=ita+eng
INBOX_OCR_TIMEOUT_SECONDS=180
# Numero di core usati da OCRmyPDF: 0 = automatico (tutti i core). Prima era fisso a 1 e raddoppiava i tempi.
INBOX_OCR_JOBS=0
# Pulizia immagine unpaper prima dell'OCR: true mantiene la resa dei campioni; false è ~25% più veloce.
INBOX_OCR_CLEAN=true
# Analisi OCR elaborate in parallelo in background: 1 = una alla volta (consigliato su hardware modesto).
INBOX_ANALYSIS_CONCURRENCY=1
# OCRMYPDF_BIN=ocrmypdf

DOCUMENT_MIRROR_ENABLED=false
DOCUMENT_MIRROR_NEXTCLOUD_BASE_URL=
DOCUMENT_MIRROR_NEXTCLOUD_USER=
DOCUMENT_MIRROR_NEXTCLOUD_PASS=
DOCUMENT_MIRROR_NEXTCLOUD_FOLDER=NFRP Portfolio Demo

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
TELEGRAM_NOTIFICATIONS_ENABLED=false

NOTIFICATION_CRON=0 8 * * *
NOTIFICATION_TIMEZONE=Europe/Rome
NOTIFICATION_FAILURE_RETRIES=3
NOTIFICATION_RETRY_DELAY_MINUTES=10
TELEGRAM_SEND_ATTEMPTS=4
TELEGRAM_SEND_TIMEOUT_MS=15000
TELEGRAM_SEND_RETRY_DELAY_MS=3000
DEFAULT_NOTICE_DAYS=30
SEED_DEMO_DATA=true

# Identità aziendale iniziale; modificabile anche da Impostazioni > Identità aziendale.
BRAND_COMPANY_NAME="Demo Logistics S.r.l."
BRAND_PRODUCT_NAME="NFRP"
BRAND_SUBTITLE="Operations Platform"
BRAND_PRIMARY_COLOR="#1f6feb"
BRAND_PRIMARY_DARK_COLOR="#185abc"
BRAND_SIDEBAR_COLOR="#182230"
BRAND_ACCENT_COLOR="#1d7f4f"
BRAND_LOGO_SOURCE=

# Solo per il profilo Compose `remote`.
CLOUDFLARE_TOKEN=
